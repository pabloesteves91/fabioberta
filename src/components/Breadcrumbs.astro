---
interface Props { items: { name: string; url: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb">
  <ol class="breadcrumbs">
    {items.map((it, i) => (
      <li>{i < items.length - 1 ? <a href={it.url}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>
