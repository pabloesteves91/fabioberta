---
interface Props { name: 'arrow' | 'arrow-left' | 'close' | 'instagram' | 'plus' | 'minus' | 'download'; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow' && <path d="M4 12h16M14 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M20 12H4M10 6l-6 6 6 6" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'minus' && <path d="M5 12h14" />}
  {name === 'download' && <path d="M12 4v11m0 0l-5-5m5 5l5-5M5 20h14" />}
  {name === 'instagram' && (<><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></>)}
</svg>
