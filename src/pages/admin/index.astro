---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/manrope';
import '../../styles/global.css';
import '../../styles/admin.css';
import local from '../../data/photos.json';
import { defaultEvents, defaultExhibitions } from '../../lib/content';
import { defaultPosts } from '../../lib/posts';
import { defaultPrintConfig } from '../../lib/prints';
export const prerender = false;

const config = {
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY,
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN,
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID,
  storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET,
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID,
  emulator: import.meta.env.PUBLIC_FIREBASE_EMULATOR === 'true',
};
const configured = Boolean(config.apiKey && config.projectId && config.storageBucket);
// Startinhalte für den Ein-Klick-Import ins leere Firebase
const defaults = configured
  ? {
      photos: (local as { category: string }[]).filter((p) => p.category !== '_site'),
      events: defaultEvents,
      exhibitions: defaultExhibitions,
      posts: (await defaultPosts()).map((p) => ({ ...p, date: p.date.toISOString() })),
      prints: defaultPrintConfig,
    }
  : null;
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0c0b0a" />
    <title>Admin · Fabio Berta</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="admin">
    {!configured ? (
      <main class="a-setup">
        <div class="a-card prose">
          <p class="eyebrow">Admin</p>
          <h1>Firebase ist noch nicht verbunden</h1>
          <p>Trage die <code>PUBLIC_FIREBASE_…</code>-Werte in Vercel (bzw. lokal in <code>.env</code>) ein. Die Schritt-für-Schritt-Anleitung findest du in <code>SETUP.md</code>.</p>
          <p>Bis dahin zeigt die Website die Platzhalterbilder.</p>
          <p><a href="/">← Zur Website</a></p>
        </div>
      </main>
    ) : (
      <>
        <script type="application/json" id="fb-config" set:html={JSON.stringify(config)} />
        <script type="application/json" id="fb-defaults" set:html={JSON.stringify(defaults)} />

        <!-- Login -->
        <main class="a-login" id="login" hidden>
          <form class="a-card a-login__card" id="login-form">
            <div class="logo"><span class="logo__name">Fabio <em>Berta</em></span><span class="logo__sub">Admin</span></div>
            <p class="muted">Melde dich an, um Bilder und Inhalte zu verwalten.</p>
            <button type="button" class="a-btn a-btn--ghost a-btn--block" id="login-google">
              <svg viewBox="0 0 24 24" width="18" aria-hidden="true"><path fill="#EA4335" d="M12 10.2v3.9h5.5c-.2 1.3-1.6 3.8-5.5 3.8-3.3 0-6-2.7-6-6.1s2.7-6.1 6-6.1c1.9 0 3.1.8 3.8 1.5l2.6-2.5C16.8 3.2 14.6 2.2 12 2.2 6.6 2.2 2.2 6.6 2.2 12s4.4 9.8 9.8 9.8c5.7 0 9.4-4 9.4-9.6 0-.6-.1-1.1-.2-1.6H12z"/></svg>
              Mit Google anmelden
            </button>
            <div class="a-or"><span>oder</span></div>
            <label class="a-field"><span>E-Mail</span><input type="email" id="login-email" required autocomplete="username" /></label>
            <label class="a-field"><span>Passwort</span><input type="password" id="login-pass" required autocomplete="current-password" /></label>
            <button class="a-btn a-btn--primary a-btn--block" type="submit">Anmelden</button>
            <button type="button" class="a-link" id="login-reset">Passwort vergessen?</button>
            <p class="a-error" id="login-error" role="alert"></p>
          </form>
        </main>

        <!-- App -->
        <div class="a-app" id="app" hidden>
          <aside class="a-nav">
            <div class="logo a-nav__logo"><span class="logo__name">Fabio <em>Berta</em></span><span class="logo__sub">Admin</span></div>
            <nav aria-label="Admin-Navigation">
              <button data-view="dashboard"><span class="a-ico">◎</span><span>Übersicht</span></button>
              <button data-view="photos"><span class="a-ico">▦</span><span>Fotos</span></button>
              <button data-view="events"><span class="a-ico">★</span><span>Events</span></button>
              <button data-view="exhibitions"><span class="a-ico">◫</span><span>Ausstellungen</span></button>
              <button data-view="posts"><span class="a-ico">✎</span><span>Journal</span></button>
              <button data-view="prices"><span class="a-ico">₣</span><span>Preise</span></button>
              <button data-view="inquiries"><span class="a-ico">✉</span><span>Anfragen</span><b class="a-badge" id="badge-inquiries" hidden></b></button>
              <button data-view="orders"><span class="a-ico">⬚</span><span>Bestellungen</span><b class="a-badge" id="badge-orders" hidden></b></button>
            </nav>
            <div class="a-nav__foot">
              <a href="/" target="_blank" rel="noopener">Website ansehen ↗</a>
              <span class="muted" id="user-email"></span>
              <button class="a-link" id="logout">Abmelden</button>
            </div>
          </aside>
          <main class="a-main" id="view" tabindex="-1"></main>
        </div>

        <!-- Seitenpanel (Bearbeiten) -->
        <div class="a-drawer" id="drawer" hidden>
          <div class="a-drawer__backdrop" data-close></div>
          <section class="a-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
            <header class="a-drawer__head">
              <h2 id="drawer-title"></h2>
              <button class="a-icon-btn" data-close aria-label="Schliessen">✕</button>
            </header>
            <div class="a-drawer__body" id="drawer-body"></div>
            <footer class="a-drawer__foot" id="drawer-foot"></footer>
          </section>
        </div>

        <!-- Modal (Upload, Bildauswahl, Bestätigung) -->
        <dialog class="a-modal" id="modal"><div id="modal-body"></div></dialog>

        <!-- Drop-Overlay -->
        <div class="a-dropzone-overlay" id="drop-overlay" hidden><div>Bilder loslassen zum Hochladen</div></div>

        <div class="a-toasts" id="toasts" aria-live="polite"></div>
      </>
    )}
    <script>
      import '../../scripts/admin';
    </script>
  </body>
</html>
