---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../lib/site';
import { abs, businessSchema, websiteSchema } from '../lib/seo';
import type { Lang, RouteKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** URL der Seite in der anderen Sprache */
  alternate: string;
  current?: RouteKey;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'product';
  jsonLd?: object[];
  noindex?: boolean;
  preload?: string;
  footerCta?: boolean;
}

const { lang, title, description, alternate, current, image = site.ogImage, imageAlt, type = 'website', jsonLd = [], noindex = false, preload, footerCta = true } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = abs(path);
const deUrl = abs(lang === 'de' ? path : alternate);
const enUrl = abs(lang === 'en' ? path : alternate);
// Marke nur anhängen, wenn der Titel dann noch in die Google-Anzeige passt (~65 Zeichen)
const fullTitle = title.includes('Fabio Berta') || title.length + 14 > 65 ? title : `${title} | Fabio Berta`;
const schemas = [businessSchema(lang), websiteSchema(lang), ...jsonLd];
---
<!doctype html>
<html lang={lang === 'de' ? 'de-CH' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" hreflang="de-CH" href={deUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={deUrl} />

    <meta property="og:type" content={type === 'product' ? 'product' : type} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(image)} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'de' ? 'en_US' : 'de_CH'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="geo.region" content="CH-ZH" />
    <meta name="geo.placename" content="Zürich" />
    <meta name="author" content="Fabio Berta" />
    <meta name="theme-color" content="#0c0b0a" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (sessionStorage.getItem('fb-intro') || matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('no-preload');
      } catch (e) { document.documentElement.classList.add('no-preload'); }
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="preloader" data-preloader transition:persist="preloader" aria-hidden="true">
      <div class="preloader__name">
        {'Fabio '.split('').map((c, i) => <span style={`--i:${i}`}>{c}</span>)}
        <em>{'Berta'.split('').map((c, i) => <span style={`--i:${i + 6}`}>{c}</span>)}</em>
      </div>
      <div class="preloader__count" data-preloader-count>000</div>
    </div>
    <Header lang={lang} alternate={alternate} current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} cta={footerCta} />
    <Lightbox lang={lang} />
    <div class="cursor" data-cursor-el transition:persist="cursor" aria-hidden="true">
      <span class="cursor__dot"></span>
      <span class="cursor__label" data-cursor-text></span>
    </div>
    <div class="grain" aria-hidden="true" transition:persist="grain"></div>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
