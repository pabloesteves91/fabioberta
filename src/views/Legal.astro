---
/**
 * Rechtstexte – VORLAGEN. Bitte vor dem Livegang mit echten Angaben ergänzen
 * und idealerweise von einer Fachperson prüfen lassen (keine Rechtsberatung).
 */
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { r, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';
import { site } from '../lib/site';
import { shipping } from '../lib/prints';

interface Props { lang: Lang; kind: 'imprint' | 'privacy' | 'terms' }
const { lang, kind } = Astro.props;
const t = useT(lang);
const de = lang === 'de';
const titles = {
  imprint: { de: 'Impressum', en: 'Imprint' },
  privacy: { de: 'Datenschutzerklärung', en: 'Privacy Policy' },
  terms: { de: 'Allgemeine Geschäftsbedingungen', en: 'Terms & Conditions' },
};
const title = titles[kind][lang];
const crumbs = [
  { name: t('nav.home'), url: r('home', lang) },
  { name: title, url: r(kind, lang) },
];
const a = site.address;
const updated = new Date('2026-11-02').toLocaleDateString(de ? 'de-CH' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base lang={lang} title={title} description={`${title} – ${site.brand}`} alternate={r(kind, de ? 'en' : 'de')} footerCta={false}>
  <section class="page-hero container">
    <Breadcrumbs items={crumbs} />
    <h1>{title}</h1>
    <p class="muted" style="margin-top:1rem">{de ? 'Stand' : 'Last updated'}: {updated}</p>
  </section>
  <section class="container">
    <div class="prose">
      {kind === 'imprint' && (
        <>
          <h2>{de ? 'Verantwortlich für den Inhalt' : 'Responsible for content'}</h2>
          <p>Fabio Berta<br />{site.brand}<br />{a.street}<br />{a.zip} {a.city}<br />{de ? 'Schweiz' : 'Switzerland'}</p>
          <p>{de ? 'Kontakt' : 'Contact'}: <a href={r('contact', lang)}>{de ? 'Kontaktformular' : 'Contact form'}</a></p>
          <p>{de ? 'UID-Nummer (falls vorhanden)' : 'UID number (if applicable)'}: [CHE-xxx.xxx.xxx]</p>
          <h2>{de ? 'Urheberrechte' : 'Copyright'}</h2>
          <p>{de
            ? 'Alle Fotografien auf dieser Website sind urheberrechtlich geschützt und Eigentum von Fabio Berta. Jede Verwendung, Vervielfältigung oder Weitergabe ohne schriftliche Zustimmung ist untersagt. Für Lizenzanfragen nutze bitte das Kontaktformular.'
            : 'All photographs on this website are protected by copyright and are the property of Fabio Berta. Any use, reproduction or distribution without written consent is prohibited. Please use the contact form for licensing requests.'}</p>
          <h2>{de ? 'Haftungsausschluss' : 'Disclaimer'}</h2>
          <p>{de
            ? 'Der Autor übernimmt keine Gewähr für die Richtigkeit, Genauigkeit, Aktualität, Zuverlässigkeit und Vollständigkeit der Informationen. Für Inhalte verlinkter Websites wird jede Verantwortung abgelehnt.'
            : 'The author assumes no liability for the correctness, accuracy, timeliness, reliability and completeness of the information. No responsibility is accepted for the content of linked websites.'}</p>
        </>
      )}

      {kind === 'privacy' && (
        <>
          <p>{de
            ? 'Diese Datenschutzerklärung informiert dich darüber, welche Personendaten wir beim Besuch dieser Website bearbeiten. Sie richtet sich nach dem Schweizer Datenschutzgesetz (DSG) und, soweit anwendbar, nach der EU-Datenschutz-Grundverordnung (DSGVO).'
            : 'This privacy policy explains which personal data we process when you visit this website. It is based on the Swiss Federal Act on Data Protection (FADP) and, where applicable, the EU General Data Protection Regulation (GDPR).'}</p>
          <h2>{de ? '1. Verantwortlicher' : '1. Controller'}</h2>
          <p>Fabio Berta, {a.street}, {a.zip} {a.city}, {de ? 'Schweiz' : 'Switzerland'}.</p>
          <h2>{de ? '2. Hosting' : '2. Hosting'}</h2>
          <p>{de
            ? 'Diese Website wird bei Vercel Inc. (USA) gehostet. Beim Aufruf werden technisch notwendige Daten (IP-Adresse, Zeitpunkt, Browser) in Server-Logs verarbeitet. Die Übermittlung in die USA erfolgt auf Grundlage von Standardvertragsklauseln bzw. des Swiss-U.S. Data Privacy Framework.'
            : 'This website is hosted by Vercel Inc. (USA). Technically necessary data (IP address, time, browser) is processed in server logs. Transfer to the USA is based on standard contractual clauses or the Swiss-U.S. Data Privacy Framework.'}</p>
          <h2>{de ? '3. Reichweitenmessung ohne Cookies' : '3. Cookieless analytics'}</h2>
          <p>{de
            ? 'Wir nutzen Vercel Web Analytics. Dabei werden keine Cookies gesetzt und keine Nutzerprofile erstellt; die Daten werden anonymisiert und aggregiert ausgewertet.'
            : 'We use Vercel Web Analytics. No cookies are set and no user profiles are created; data is anonymised and aggregated.'}</p>
          <h2>{de ? '4. Kontaktformular' : '4. Contact form'}</h2>
          <p>{de
            ? 'Wenn du uns über das Formular kontaktierst, speichern wir deine Angaben (Name, E-Mail, optional Telefon, Nachricht) in unserer Datenbank bei Supabase (Serverstandort EU) und versenden eine Benachrichtigung über Resend. Die Daten nutzen wir ausschliesslich zur Bearbeitung deiner Anfrage und löschen sie, sobald sie nicht mehr benötigt werden.'
            : 'If you contact us via the form, we store your details (name, email, optional phone, message) in our database at Supabase (EU server location) and send a notification via Resend. We use the data solely to handle your request and delete it once it is no longer required.'}</p>
          <h2>{de ? '5. Bestellungen & Zahlung' : '5. Orders & payment'}</h2>
          <p>{de
            ? 'Zahlungen werden über Stripe Payments Europe Ltd. abgewickelt. Deine Zahlungsdaten werden direkt von Stripe verarbeitet; wir erhalten nur Name, E-Mail, Lieferadresse und Bestellinformationen, die wir zur Vertragserfüllung und zur Erfüllung gesetzlicher Aufbewahrungspflichten speichern.'
            : 'Payments are processed by Stripe Payments Europe Ltd. Your payment details are processed directly by Stripe; we only receive name, email, shipping address and order details, which we store to fulfil the contract and legal retention obligations.'}</p>
          <h2>{de ? '6. Schriftarten' : '6. Fonts'}</h2>
          <p>{de ? 'Alle Schriftarten werden lokal von unserem Server geladen. Es findet keine Verbindung zu Google Fonts statt.' : 'All fonts are served locally from our server. No connection to Google Fonts is made.'}</p>
          <h2>{de ? '7. Instagram' : '7. Instagram'}</h2>
          <p>{de ? 'Wir verlinken auf unser Instagram-Profil. Erst wenn du den Link anklickst, werden Daten an Meta übertragen.' : 'We link to our Instagram profile. Data is only transferred to Meta once you click the link.'}</p>
          <h2>{de ? '8. Deine Rechte' : '8. Your rights'}</h2>
          <p>{de
            ? 'Du hast das Recht auf Auskunft, Berichtigung, Löschung und Herausgabe deiner Daten sowie auf Widerspruch gegen die Bearbeitung. Wende dich dazu an uns über das Kontaktformular. Du kannst dich zudem beim EDÖB bzw. einer zuständigen Aufsichtsbehörde beschweren.'
            : 'You have the right to access, rectify, erase and port your data and to object to processing. Please contact us via the contact form. You may also lodge a complaint with the FDPIC or a competent supervisory authority.'}</p>
        </>
      )}

      {kind === 'terms' && (
        <>
          <h2>{de ? '1. Geltungsbereich' : '1. Scope'}</h2>
          <p>{de
            ? `Diese AGB gelten für alle Bestellungen von Fotoprints über ${site.url} sowie für Fotografie-Aufträge von ${site.brand}, sofern nicht schriftlich anders vereinbart.`
            : `These terms apply to all orders of photo prints via ${site.url} and to photography assignments by ${site.brand}, unless otherwise agreed in writing.`}</p>
          <h2>{de ? '2. Vertragsschluss' : '2. Conclusion of contract'}</h2>
          <p>{de ? 'Der Vertrag kommt mit Abschluss der Zahlung im Checkout zustande. Du erhältst eine Bestätigung per E-Mail.' : 'The contract is concluded when payment is completed at checkout. You will receive a confirmation email.'}</p>
          <h2>{de ? '3. Preise & Zahlung' : '3. Prices & payment'}</h2>
          <p>{de
            ? `Alle Preise verstehen sich in Schweizer Franken (CHF). Versand: Schweiz & Liechtenstein CHF ${shipping.ch.price}, Europa CHF ${shipping.eu.price}, ab CHF ${shipping.freeFrom} kostenlos. Die Zahlung erfolgt über Stripe (z. B. TWINT, Kreditkarte, Apple Pay).`
            : `All prices are in Swiss francs (CHF). Shipping: Switzerland & Liechtenstein CHF ${shipping.ch.price}, Europe CHF ${shipping.eu.price}, free from CHF ${shipping.freeFrom}. Payment via Stripe (e.g. TWINT, credit card, Apple Pay).`}</p>
          <h2>{de ? '4. Produktion & Lieferung' : '4. Production & delivery'}</h2>
          <p>{de ? 'Jeder Print wird individuell für dich produziert. Die Lieferzeit beträgt in der Regel 7–10 Arbeitstage. Bei Lieferungen ausserhalb der Schweiz können Zölle und Gebühren anfallen.' : 'Each print is produced individually for you. Delivery usually takes 7–10 working days. Customs duties may apply for deliveries outside Switzerland.'}</p>
          <h2>{de ? '5. Rückgabe' : '5. Returns'}</h2>
          <p>{de ? 'Da Prints individuell angefertigt werden, ist ein Umtausch ausgeschlossen. Bei Transportschäden oder Produktionsfehlern melde dich bitte innert 7 Tagen mit Fotos – wir ersetzen den Print kostenlos.' : 'As prints are made to order, exchanges are excluded. In case of transport damage or production defects, please contact us within 7 days with photos – we will replace the print free of charge.'}</p>
          <h2>{de ? '6. Urheber- & Nutzungsrechte' : '6. Copyright & usage rights'}</h2>
          <p>{de ? 'Mit dem Kauf eines Prints erwirbst du das Eigentum am physischen Werk, nicht aber Urheber- oder Nutzungsrechte. Die kommerzielle Nutzung von Bildern erfordert eine separate Lizenz. Für Shootings werden Nutzungsrechte im jeweiligen Angebot festgelegt.' : 'Purchasing a print transfers ownership of the physical work, not copyright or usage rights. Commercial use requires a separate licence. For shoots, usage rights are defined in the respective quote.'}</p>
          <h2>{de ? '7. Anwendbares Recht' : '7. Applicable law'}</h2>
          <p>{de ? 'Es gilt Schweizer Recht. Gerichtsstand ist Zürich.' : 'Swiss law applies. Place of jurisdiction is Zurich.'}</p>
        </>
      )}
    </div>
  </section>
</Base>
