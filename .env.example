# ---------- Firebase (Web-App) – öffentlich, im Browser sichtbar ----------
# Firebase Console → Projekteinstellungen → Allgemein → «Meine Apps» → Web-App → Konfiguration
PUBLIC_FIREBASE_API_KEY=AIza...
PUBLIC_FIREBASE_AUTH_DOMAIN=dein-projekt.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=dein-projekt
PUBLIC_FIREBASE_STORAGE_BUCKET=dein-projekt.firebasestorage.app
PUBLIC_FIREBASE_APP_ID=1:123:web:abc

# ---------- Firebase Admin – GEHEIM, nur Server ----------
# Projekteinstellungen → Dienstkonten → «Neuen privaten Schlüssel generieren» (JSON-Datei)
FIREBASE_PROJECT_ID=dein-projekt
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@dein-projekt.iam.gserviceaccount.com
# Den ganzen Schlüssel inkl. -----BEGIN/END----- in Anführungszeichen, Zeilenumbrüche als \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------- E-Mail (Resend) ----------
RESEND_API_KEY=re_...
NOTIFY_EMAIL=fabioberta@me.com
MAIL_FROM="Fabio Berta Website <website@fabioberta.com>"
